# The master password Flask uses to cryptographically sign user session cookies.
# If an attacker steals this, they can forge a fake admin cookie and bypass login.
FLASK_SECRET_KEY=supersecretkey123

# The network address where the database lives.
# Because we are using Docker, we just use the name of the database container ("db") 
# instead of an IP address like 127.0.0.1. Docker routes it automatically.
MYSQL_HOST=db

# The restricted username your Python web app uses to connect to the database.
MYSQL_USER=vulnuser

# The password that belongs to the MYSQL_USER account.
MYSQL_PASSWORD=vulnpass

# The specific workspace/schema inside the database server where your tables 
# (like 'users', 'posts', 'uploads') will be created and stored.
MYSQL_DATABASE=vulnboard

# The master administrator password for the entire MySQL engine.
# Docker uses this once during startup to set up the server and create the 
# 'vulnuser' account and 'vulnboard' database.
MYSQL_ROOT_PASSWORD=rootpass
